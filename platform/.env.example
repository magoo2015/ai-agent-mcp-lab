# AI Security Engineering Platform — environment variables
# Copy to .env and adjust as needed: cp .env.example .env
#
# Docker Compose loads .env from this directory automatically when present.

# Compose project name (must match existing volume names if volumes already exist)
COMPOSE_PROJECT_NAME=ai-security-platform

# Public HTTP port exposed by Nginx (maps host:container in docker-compose.yml)
NGINX_HTTP_PORT=80

# Ollama API URL as seen by services inside the Docker network
OLLAMA_BASE_URL=http://ollama:11434

# AI Gateway defaults
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=tinyllama

# Gateway access control (required for POST /chat; never commit a real value)
GATEWAY_API_KEY=replace_with_a_long_random_value

# Request limits (lab defaults)
MAX_PROMPT_CHARS=12000
MAX_REQUEST_BYTES=65536

# OpenAI (cloud provider — set OPENAI_API_KEY in .env only, never commit it)
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=replace_me

# Default Ollama model pulled during setup (informational)
# DEFAULT_MODEL=gemma2:2b

# Open WebUI image tag (future use — compose currently pins :main)
# OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
