# Inactive template: replace __PLATFORM_DOMAIN__ with the validated public
# hostname only after its certificate exists, then activate as documented.
server {
    listen 80;
    server_name __PLATFORM_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://__PLATFORM_DOMAIN__$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name __PLATFORM_DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__PLATFORM_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PLATFORM_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;

    # HSTS is deliberately omitted until HTTPS and renewal are validated.
    # CSP is deliberately omitted until Open WebUI and Grafana compatibility is tested.

    location = /metrics {
        return 404;
    }

    location = /metrics/ {
        return 404;
    }

    location ^~ /gateway/metrics {
        return 404;
    }

    location /gateway/ {
        client_max_body_size 64k;

        proxy_pass http://ai-gateway:8000/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-API-Key $http_x_api_key;

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    location /grafana/ {
        proxy_pass http://grafana:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location = /grafana {
        return 301 /grafana/;
    }

    location / {
        proxy_pass http://open-webui:8080;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
